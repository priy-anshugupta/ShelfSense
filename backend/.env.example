# SQLite works immediately. Optional: use Supabase's PostgreSQL pooler URI.
DATABASE_URL=sqlite:///./storage/shelfsense.db
DEMO_MODE=true
GATEWAY_SECRET=local-demo-only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alias remains supported.
SUPABASE_ANON_KEY=
# Comma-separated local account UUIDs or Supabase user IDs authorized for staff routes.
STAFF_USER_IDS=
# Optional local Sentence Transformer model; install requirements-semantic.txt first.
EMBEDDING_MODEL=
INVENTORY_FRESHNESS_HOURS=24
